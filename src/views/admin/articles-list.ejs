<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Articles</h1><p>Canonical long-form content for arefsaran.ir and LinkedIn distribution.</p></div><div class="admin-actions"><a class="btn btn-primary" href="/admin/articles/new">+ New article</a></div></div><form class="filters" method="get"><input name="q" value="<%= filters.q || '' %>" placeholder="Search"><select name="status"><option value="">All statuses</option><% ['draft','scheduled','published','archived'].forEach(s=> { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select><select name="series"><option value="">All series</option><% series.forEach(s=> { %><option value="<%= s %>" <%= filters.series===s?'selected':'' %>><%= s %></option><% }) %></select><select name="tag"><option value="">All tags</option><% tags.forEach(tag=> { %><option value="<%= tag %>" <%= filters.tag===tag?'selected':'' %>><%= tag %></option><% }) %></select><select name="featured"><option value="">Featured: all</option><option value="true" <%= filters.featured==='true'?'selected':'' %>>Featured only</option><option value="false" <%= filters.featured==='false'?'selected':'' %>>Not featured</option></select><select name="missing"><option value="">All content</option><option value="linkedin" <%= filters.missing==='linkedin'?'selected':'' %>>Missing LinkedIn</option><option value="seo" <%= filters.missing==='seo'?'selected':'' %>>Missing SEO</option><option value="cover" <%= filters.missing==='cover'?'selected':'' %>>Missing cover</option></select><select name="sort"><option value="updated" <%= !filters.sort || filters.sort==='updated'?'selected':'' %>>Sort: updated</option><option value="created" <%= filters.sort==='created'?'selected':'' %>>Sort: created</option><option value="published" <%= filters.sort==='published'?'selected':'' %>>Sort: published</option><option value="title" <%= filters.sort==='title'?'selected':'' %>>Sort: title</option></select><button class="btn" type="submit">Filter</button></form><div class="table-wrap"><table><thead><tr><th>Article</th><th>Series</th><th>Status</th><th>LinkedIn</th><th>Updated</th><th></th></tr></thead><tbody><% articles.forEach(a=> { %><tr><td><strong><%= a.title %></strong><br><small>/<%= a.slug %></small></td><td><%= a.series || '—' %></td><td><span class="status"><%= a.status %></span></td><td><%= a.linkedinStatus %></td><td><%= new Date(a.updatedAt).toLocaleString('en-GB') %></td><td><a href="/admin/articles/<%= a._id %>">Edit</a></td></tr><% }) %></tbody></table></div><%- include('../partials/admin-foot') %>
