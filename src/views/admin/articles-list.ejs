<%- include('../partials/admin-head',{title}) %>
<div class="admin-top"><div><h1>Articles</h1><p>Drafts and published engineering articles.</p></div><a class="btn btn-primary" href="/admin/articles/new">+ New article</a></div>
<div class="table-wrap"><table><thead><tr><th>Title / slug</th><th>Status</th><th>Created</th><th>Updated</th><th>Published</th><th>Actions</th></tr></thead><tbody>
<% articles.forEach(article => { %><tr><td><strong><%= article.title %></strong><br><small>/<%= article.slug %></small></td><td><span class="status"><%= article.status %></span></td><td><%= new Date(article.createdAt).toLocaleDateString('en-GB') %></td><td><%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></td><td><%= article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('en-GB') : '—' %></td><td><a href="/admin/articles/<%= article._id %>">Edit</a> · <a href="/admin/articles/<%= article._id %>/preview" target="_blank" rel="noopener noreferrer">Preview</a></td></tr><% }) %>
</tbody></table></div><% if (!articles.length) { %><p>No articles yet.</p><% } %>
<%- include('../partials/admin-foot') %>
