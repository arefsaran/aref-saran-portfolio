<%- include('../partials/admin-head',{title}) %>
<div class="admin-top"><div><h1><%= article? 'Edit article' : 'New article' %></h1><p>Write once, publish here, derive the LinkedIn version from the same source.</p></div><div class="admin-actions"><% if(article?._id){ %><a class="btn" target="_blank" rel="noopener noreferrer" href="/admin/articles/<%= article._id %>/preview">Preview</a><a class="btn" href="/admin/articles/<%= article._id %>/export.md">Export Markdown</a><button class="btn" type="submit" form="duplicate-form">Duplicate</button><% } %><a class="btn" href="/admin/articles">Back</a></div></div>
<% if(typeof saved !== 'undefined' && saved){ %><div class="notice" role="status">Saved.</div><% } %><% if(error){ %><div class="error" role="alert"><%= error %></div><% } %>
<% if(article?._id){ %><form id="duplicate-form" method="post" action="/admin/articles/<%= article._id %>/duplicate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %>
<form data-unsaved-form method="post" action="<%= article?._id ? '/admin/articles/'+article._id : '/admin/articles' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="stack"><section class="panel"><div class="field"><label for="title">Title</label><input data-title-source id="title" name="title" value="<%= article?.title || '' %>" required></div><div class="field"><label for="slug">Slug</label><input data-slug-target id="slug" name="slug" value="<%= article?.slug || '' %>" required><small>Changing a published slug keeps the old slug as a redirect.</small></div><div class="field"><label for="subtitle">Subtitle</label><input id="subtitle" name="subtitle" value="<%= article?.subtitle || '' %>"></div><div class="field"><label for="excerpt">Excerpt</label><textarea id="excerpt" name="excerpt" rows="4" required><%= article?.excerpt || '' %></textarea></div><div class="field"><label for="article-template">Writing template</label><div class="admin-actions"><select id="article-template"><option value="">Choose a structure</option><option value="note">Test Engineering Note</option><option value="case">Case-based Article</option><option value="tutorial">Tutorial</option></select><button class="btn" type="button" data-apply-template>Apply to empty editor</button></div></div><div class="field"><label for="body">Markdown article</label><textarea class="editor" id="body" name="body" required><%= article?.body || '' %></textarea><small>Estimated reading time: <%= readingTime %> min. Raw HTML is sanitized before public rendering.</small></div></section>
<section class="panel" id="linkedin"><h2>LinkedIn derivative</h2><p>Review this separately. The website article remains canonical.</p><div class="field"><label for="linkedinHook">Hook</label><textarea id="linkedinHook" name="linkedinHook" rows="3"><%= article?.linkedinHook || '' %></textarea></div><div class="field"><label for="linkedinSummary">Summary</label><textarea id="linkedinSummary" name="linkedinSummary" rows="5"><%= article?.linkedinSummary || '' %></textarea></div><div class="field"><label for="linkedinKeyPoints">Key points</label><textarea id="linkedinKeyPoints" name="linkedinKeyPoints" rows="5" placeholder="One per line"><%= (article?.linkedinKeyPoints || []).join('\n') %></textarea></div><div class="field"><label for="linkedinCTA">CTA</label><textarea id="linkedinCTA" name="linkedinCTA" rows="2"><%= article?.linkedinCTA || '' %></textarea></div><div class="field"><label for="linkedinHashtags">Hashtags</label><input id="linkedinHashtags" name="linkedinHashtags" value="<%= (article?.linkedinHashtags || []).join(', ') %>"></div><div class="field"><label for="linkedinStatus">Status</label><select id="linkedinStatus" name="linkedinStatus"><% ['not_created','draft','ready','posted'].forEach(s=> { %><option value="<%= s %>" <%= (article?.linkedinStatus||'not_created')===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="field"><label for="linkedinPostUrl">Posted URL</label><input id="linkedinPostUrl" type="url" name="linkedinPostUrl" value="<%= article?.linkedinPostUrl || '' %>"></div><div class="field"><label for="linkedinPostedAt">Posted at</label><input id="linkedinPostedAt" type="datetime-local" name="linkedinPostedAt" value="<%= article?.linkedinPostedAt ? new Date(article.linkedinPostedAt).toISOString().slice(0,16) : '' %>"></div><% if(linkedinDraft){ %><h3>Copy-ready preview</h3><div id="linkedin-preview" class="linkedin-preview"><%= linkedinDraft %></div><button class="btn" type="button" data-copy-target="#linkedin-preview">Copy LinkedIn post</button><% } %><% if(article?._id){ %><button class="btn" type="submit" formaction="/admin/articles/<%= article._id %>/linkedin-generate">Generate deterministic draft</button><% } %></section></div>
<aside class="stack"><section class="panel"><h2>Publishing</h2><% if(article?._id){ %><div class="field"><label for="article-public-url">Public URL</label><div class="admin-actions"><input id="article-public-url" value="<%= baseUrl %>/articles/<%= article.slug %>" readonly><button class="btn" type="button" data-copy-target="#article-public-url">Copy URL</button></div></div><% } %><div class="field"><label for="status">Status</label><select id="status" name="status"><% ['draft','scheduled','published','archived'].forEach(s=> { %><option value="<%= s %>" <%= (article?.status||'draft')===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="field"><label for="publishedAt">Published at</label><input id="publishedAt" type="datetime-local" name="publishedAt" value="<%= article?.publishedAt ? new Date(article.publishedAt).toISOString().slice(0,16) : '' %>"></div><div class="field"><label for="scheduledAt">Schedule for</label><input id="scheduledAt" type="datetime-local" name="scheduledAt" value="<%= article?.scheduledAt ? new Date(article.scheduledAt).toISOString().slice(0,16) : '' %>"></div><label class="checkbox"><input type="checkbox" name="featured" <%= article?.featured?'checked':'' %>> Featured</label><button class="btn btn-primary" type="submit">Save article</button></section>
<section class="panel"><h2>Organization</h2><div class="field"><label for="series">Series</label><input id="series" name="series" value="<%= article?.series || '' %>" placeholder="Test Engineering Notes"></div><div class="field"><label for="tags">Tags</label><textarea id="tags" name="tags" rows="3" placeholder="Robot Framework, API Testing"><%= (article?.tags || []).join(', ') %></textarea></div><div class="field"><label for="language">Language</label><select id="language" name="language"><% ['en','de','fa'].forEach(s=> { %><option value="<%= s %>" <%= (article?.language||'en')===s?'selected':'' %>><%= s.toUpperCase() %></option><% }) %></select></div><div class="field"><label for="germanSummary">German summary</label><textarea id="germanSummary" name="germanSummary" rows="4"><%= article?.germanSummary || '' %></textarea></div></section>
<section class="panel"><h2>SEO & social</h2><div class="field"><label for="seoTitle">SEO title</label><input id="seoTitle" name="seoTitle" maxlength="120" value="<%= article?.seoTitle || '' %>"></div><div class="field"><label for="seoDescription">Meta description</label><textarea id="seoDescription" name="seoDescription" rows="4" maxlength="300"><%= article?.seoDescription || '' %></textarea></div><div class="field"><label for="canonicalUrl">Canonical URL</label><input id="canonicalUrl" type="url" name="canonicalUrl" value="<%= article?.canonicalUrl || '' %>"></div><div class="field"><label for="coverImage">Cover image URL</label><input id="coverImage" name="coverImage" value="<%= article?.coverImage || '' %>"></div><div class="field"><label for="ogImage">OG image URL</label><input id="ogImage" name="ogImage" value="<%= article?.ogImage || '' %>"></div><h3>Search/social preview</h3><div class="seo-preview"><small><%= baseUrl %>/articles/<span data-preview-slug><%= article?.slug || 'article-slug' %></span></small><strong data-preview-title><%= article?.seoTitle || article?.title || 'Article title' %></strong><p data-preview-description><%= article?.seoDescription || article?.excerpt || 'Article description' %></p></div></section>
<section class="panel"><h2>Related engineering work</h2><div class="field"><label for="relatedCaseStudies">Case studies</label><select id="relatedCaseStudies" name="relatedCaseStudies" multiple size="5"><% (caseStudies || []).forEach(item=> { %><option value="<%= item._id %>" <%= (article?.relatedCaseStudies || []).some(id=>String(id)===String(item._id))?'selected':'' %>><%= item.title %></option><% }) %></select></div><div class="field"><label for="relatedProjects">Projects</label><select id="relatedProjects" name="relatedProjects" multiple size="5"><% (projects || []).forEach(item=> { %><option value="<%= item._id %>" <%= (article?.relatedProjects || []).some(id=>String(id)===String(item._id))?'selected':'' %>><%= item.name %></option><% }) %></select></div><div class="field"><label for="relatedVideos">Videos</label><select id="relatedVideos" name="relatedVideos" multiple size="5"><% (videos || []).forEach(item=> { %><option value="<%= item._id %>" <%= (article?.relatedVideos || []).some(id=>String(id)===String(item._id))?'selected':'' %>><%= item.title %></option><% }) %></select></div><small>Hold Ctrl/Cmd to select multiple items.</small></section>
<section class="panel"><h2>Internal notes</h2><div class="hint">Before publishing FinTech content: remove company secrets, production URLs, credentials, customer data, private architecture, and unverified metrics.</div><div class="field"><label for="internalNotes">Notes (never public)</label><textarea id="internalNotes" name="internalNotes" rows="6"><%= article?.internalNotes || '' %></textarea></div></section>
<% if(article?._id){ %><section class="panel"><h2>Revision safety</h2><p><%= article.revisions?.length || 0 %> saved snapshots (latest 20 kept).</p><% if(article.revisions?.length){ %><div class="stack"><% article.revisions.slice(-5).reverse().forEach((revision,reverseIndex)=> { const actualIndex=article.revisions.length-1-reverseIndex; %><div><small><%= revision.savedAt ? new Date(revision.savedAt).toLocaleString('en-GB') : 'Saved revision' %></small><button class="btn" type="submit" formaction="/admin/articles/<%= article._id %>/revisions/<%= actualIndex %>/restore">Restore this text</button></div><% }) %></div><% } %><button class="btn btn-danger" type="submit" formaction="/admin/articles/<%= article._id %>/archive">Archive article</button></section><% } %></aside></div></form>
<%- include('../partials/admin-foot') %>
