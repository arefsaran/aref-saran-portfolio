<%- include('../partials/admin-head',{title}) %>
<div class="admin-top"><div><h1><%= article?._id ? 'Edit article' : 'New article' %></h1><p>Write in Markdown, save a draft, preview, then publish.</p></div><a class="btn" href="/admin/articles">Back to articles</a></div>
<% if (typeof saved !== 'undefined' && saved) { %><div class="notice" role="status">Saved.</div><% } %>
<% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
<form data-unsaved-form method="post" action="<%= article?._id ? '/admin/articles/' + article._id : '/admin/articles' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-grid"><section class="panel stack">
    <div class="field"><label for="title">Title</label><input data-title-source id="title" name="title" maxlength="200" value="<%= article?.title || '' %>" required></div>
    <div class="field"><label for="slug">Slug</label><input data-slug-target id="slug" name="slug" maxlength="200" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" value="<%= article?.slug || '' %>" required><small>Changing a published slug keeps the old URL as a redirect.</small></div>
    <div class="field"><label for="excerpt">Excerpt</label><textarea id="excerpt" name="excerpt" maxlength="500" rows="4" required><%= article?.excerpt || '' %></textarea></div>
    <div class="field"><label for="body">Markdown article</label><textarea class="editor" id="body" name="body" required><%= article?.body || '' %></textarea><small>Supports headings, code blocks, tables, links and lists. HTML is sanitized on display.</small></div>
    <button class="btn btn-primary" type="submit">Save article</button>
  </section><aside class="stack">
    <section class="panel stack"><h2>Publication</h2><p>Status: <strong><%= article?.status || 'draft' %></strong></p><% if (article?._id) { %><p>Created: <%= new Date(article.createdAt).toLocaleString('en-GB') %><br>Updated: <%= new Date(article.updatedAt).toLocaleString('en-GB') %><% if (article.publishedAt) { %><br>First published: <span data-published-at><%= new Date(article.publishedAt).toLocaleString('en-GB') %></span><% } %></p><a class="btn" target="_blank" rel="noopener noreferrer" href="/admin/articles/<%= article._id %>/preview">Preview saved version</a><% if (article.status === 'published') { %><a class="btn" target="_blank" rel="noopener noreferrer" href="/articles/<%= article.slug %>">Public article</a><% } %><% } else { %><p>Save before previewing or publishing.</p><% } %></section>
    <section class="panel stack"><h2>Metadata</h2><div class="field"><label for="tags">Tags</label><input id="tags" name="tags" value="<%= (article?.tags || []).join(', ') %>" placeholder="API Testing, Automation"></div><div class="field"><label for="seoTitle">SEO title</label><input id="seoTitle" name="seoTitle" maxlength="120" value="<%= article?.seoTitle || '' %>"></div><div class="field"><label for="seoDescription">SEO description</label><textarea id="seoDescription" name="seoDescription" maxlength="300" rows="4"><%= article?.seoDescription || '' %></textarea></div></section>
  </aside></div>
</form>
<% if (article?._id) { %><section class="panel"><h2>Article actions</h2><div class="admin-actions"><% if (article.status !== 'published') { %><form method="post" action="/admin/articles/<%= article._id %>/publish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit">Publish</button></form><% } else { %><form method="post" action="/admin/articles/<%= article._id %>/unpublish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Unpublish</button></form><% } %><form method="post" action="/admin/articles/<%= article._id %>/delete" onsubmit="return confirm('Permanently delete this article?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="confirm" value="delete"><button class="btn btn-danger" type="submit">Delete</button></form></div></section><% } %>
<%- include('../partials/admin-foot') %>
