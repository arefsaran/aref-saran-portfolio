<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Media</h1><p>Validated image uploads for articles and social previews.</p></div></div><% if(error){ %><div class="error"><%= error %></div><% } %><section class="panel"><form method="post" enctype="multipart/form-data" action="/admin/media"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label for="file">Image</label><input id="file" name="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" required></div><div class="field"><label for="alt">Alt text</label><input id="alt" name="alt" required></div></div><div class="field"><label for="caption">Caption</label><input id="caption" name="caption"></div><button class="btn btn-primary" type="submit">Upload</button></form></section><div class="media-grid" style="margin-top:1rem"><% media.forEach(item=> { %><article class="media-card"><img src="<%= item.url %>" alt="<%= item.alt || '' %>"><div><strong><%= item.originalName %></strong><p><%= item.alt || 'No alt text' %></p><input value="<%= item.url %>" readonly><form method="post" action="/admin/media/<%= item._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger" type="submit">Delete if unused</button></form></div></article><% }) %></div><%- include('../partials/admin-foot') %>
