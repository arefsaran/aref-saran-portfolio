<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Projects</h1><p>Do not represent planned projects as completed work.</p></div></div><div class="split-list"><section class="panel"><h2><%= editing?'Edit':'Add' %> project</h2><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(editing){ %><input type="hidden" name="id" value="<%= editing._id %>"><% } %><div class="field"><label>Name<input name="name" value="<%= editing?.name || '' %>" required></label></div><div class="field"><label>Slug<input name="slug" value="<%= editing?.slug || '' %>"></label></div><div class="field"><label>Summary<textarea name="summary" required><%= editing?.summary || '' %></textarea></label></div><div class="field"><label>Description<textarea name="description"><%= editing?.description || '' %></textarea></label></div><div class="field"><label>Technologies<input name="technologies" value="<%= (editing?.technologies || []).join(', ') %>"></label></div><div class="field"><label>GitHub URL<input name="githubUrl" type="url" value="<%= editing?.githubUrl || '' %>"></label></div><div class="field"><label>Live URL<input name="liveUrl" type="url" value="<%= editing?.liveUrl || '' %>"></label></div><div class="field"><label>Status<select name="status"><% ['planned','experimental','active','maintained','archived'].forEach(s=> { %><option value="<%= s %>" <%= (editing?.status||'planned')===s?'selected':'' %>><%= s %></option><% }) %></select></label></div><div class="field"><label>Order<input name="order" type="number" value="<%= editing?.order || 0 %>"></label></div><label class="checkbox"><input type="checkbox" name="featured" <%= editing?.featured?'checked':'' %>> Featured</label><div class="admin-actions"><button class="btn btn-primary" type="submit"><%= editing?'Save changes':'Create' %></button><% if(editing){ %><a class="btn" href="/admin/projects">Cancel</a><button class="btn btn-danger" type="submit" formaction="/admin/projects/<%= editing._id %>/archive">Archive</button><% } %></div></form></section><section><div class="table-wrap"><table><thead><tr><th>Project</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% items.forEach(i=> { %><tr><td><strong><%= i.name %></strong><br><small>/<%= i.slug %></small></td><td><span class="status"><%= i.status %></span></td><td><%= new Date(i.updatedAt).toLocaleString('en-GB') %></td><td><a href="/admin/projects?edit=<%= i._id %>">Edit</a></td></tr><% }) %></tbody></table></div></section></div><%- include('../partials/admin-foot') %>
