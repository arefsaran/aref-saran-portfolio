<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Site settings</h1><p>Public identity and links. Secrets never belong here.</p></div></div><% if(saved){ %><div class="notice" role="status">Settings saved.</div><% } %><section class="panel"><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="stack"><div class="field"><label for="siteTitle">Site title</label><input id="siteTitle" name="siteTitle" value="<%= site.siteTitle %>" required></div><div class="field"><label for="defaultSeoDescription">Default SEO description</label><textarea id="defaultSeoDescription" name="defaultSeoDescription" rows="4"><%= site.defaultSeoDescription %></textarea></div><div class="field"><label for="authorName">Author name</label><input id="authorName" name="authorName" value="<%= site.authorName %>"></div><div class="field"><label for="opportunityText">Opportunity text</label><input id="opportunityText" name="opportunityText" value="<%= site.opportunityText %>"></div><div class="field"><label for="publicEmail">Public email</label><input id="publicEmail" type="email" name="publicEmail" value="<%= site.publicEmail %>"></div></div><div class="stack"><div class="field"><label for="linkedinUrl">LinkedIn URL</label><input id="linkedinUrl" type="url" name="linkedinUrl" value="<%= site.linkedinUrl %>"></div><div class="field"><label for="githubUrl">GitHub URL</label><input id="githubUrl" type="url" name="githubUrl" value="<%= site.githubUrl %>"></div><div class="field"><label for="youtubeUrl">YouTube URL</label><input id="youtubeUrl" type="url" name="youtubeUrl" value="<%= site.youtubeUrl %>"></div><div class="field"><label for="cvUrl">CV URL</label><input id="cvUrl" type="url" name="cvUrl" value="<%= site.cvUrl %>"></div><div class="field"><label for="learningGermanUrl">German learning URL</label><input id="learningGermanUrl" type="url" name="learningGermanUrl" value="<%= site.learningGermanUrl %>"></div><div class="field"><label for="defaultOgImage">Default OG image</label><input id="defaultOgImage" name="defaultOgImage" value="<%= site.defaultOgImage %>"></div></div></div><div class="admin-actions" style="margin-top:1rem"><button class="btn btn-primary" type="submit">Save settings</button></div></form></section><%- include('../partials/admin-foot') %>
