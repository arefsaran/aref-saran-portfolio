<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Case studies</h1><p>Generalized evidence. Do not expose confidential implementation details.</p></div></div><div class="split-list"><section class="panel"><h2><%= editing ? 'Edit' : 'Add' %> case study</h2><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(editing){ %><input type="hidden" name="id" value="<%= editing._id %>"><% } %><div class="field"><label>Title<input name="title" value="<%= editing?.title || '' %>" required></label></div><div class="field"><label>Slug<input name="slug" value="<%= editing?.slug || '' %>"></label></div><div class="field"><label>Summary<textarea name="summary" required><%= editing?.summary || '' %></textarea></label></div><div class="field"><label>Problem<textarea name="problem"><%= editing?.problem || '' %></textarea></label></div><div class="field"><label>Context<textarea name="context"><%= editing?.context || '' %></textarea></label></div><div class="field"><label>Constraints<textarea name="constraints"><%= editing?.constraints || '' %></textarea></label></div><div class="field"><label>Risks<textarea name="risks"><%= editing?.risks || '' %></textarea></label></div><div class="field"><label>Approach<textarea name="approach"><%= editing?.approach || '' %></textarea></label></div><div class="field"><label>Architecture<textarea name="architecture"><%= editing?.architecture || '' %></textarea></label></div><div class="field"><label>Implementation<textarea name="implementation"><%= editing?.implementation || '' %></textarea></label></div><div class="field"><label>Validation<textarea name="validation"><%= editing?.validation || '' %></textarea></label></div><div class="field"><label>Result<textarea name="result"><%= editing?.result || '' %></textarea></label></div><div class="field"><label>Lessons<textarea name="lessons"><%= editing?.lessons || '' %></textarea></label></div><div class="field"><label>Technologies<input name="technologies" value="<%= (editing?.technologies || []).join(', ') %>"></label></div><div class="field"><label>Status<select name="status"><% ['draft','published','archived'].forEach(s=> { %><option value="<%= s %>" <%= (editing?.status||'draft')===s?'selected':'' %>><%= s %></option><% }) %></select></label></div><label class="checkbox"><input type="checkbox" name="featured" <%= editing?.featured?'checked':'' %>> Featured</label><div class="admin-actions"><button class="btn btn-primary" type="submit"><%= editing?'Save changes':'Create' %></button><% if(editing){ %><a class="btn" href="/admin/case-studies">Cancel</a><button class="btn btn-danger" type="submit" formaction="/admin/case-studies/<%= editing._id %>/archive">Archive</button><% } %></div></form></section><section><div class="table-wrap"><table><thead><tr><th>Title</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% items.forEach(i=> { %><tr><td><strong><%= i.title %></strong><br><small>/<%= i.slug %></small></td><td><span class="status"><%= i.status %></span></td><td><%= new Date(i.updatedAt).toLocaleString('en-GB') %></td><td><a href="/admin/case-studies?edit=<%= i._id %>">Edit</a></td></tr><% }) %></tbody></table></div></section></div><%- include('../partials/admin-foot') %>
