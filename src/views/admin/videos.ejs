<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Videos</h1><p>Add only videos that actually exist.</p></div></div><div class="split-list"><section class="panel"><h2><%= editing?'Edit':'Add' %> video</h2><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(editing){ %><input type="hidden" name="id" value="<%= editing._id %>"><% } %><div class="field"><label>Title<input name="title" value="<%= editing?.title || '' %>" required></label></div><div class="field"><label>Slug<input name="slug" value="<%= editing?.slug || '' %>"></label></div><div class="field"><label>Description<textarea name="description"><%= editing?.description || '' %></textarea></label></div><div class="field"><label>YouTube URL<input name="youtubeUrl" type="url" value="<%= editing?.youtubeUrl || '' %>"></label></div><div class="field"><label>YouTube ID<input name="youtubeId" value="<%= editing?.youtubeId || '' %>"></label></div><div class="field"><label>Series<input name="series" value="<%= editing?.series || '' %>"></label></div><div class="field"><label>Topic<input name="topic" value="<%= editing?.topic || '' %>"></label></div><div class="field"><label>Thumbnail URL<input name="thumbnail" value="<%= editing?.thumbnail || '' %>"></label></div><div class="field"><label>Published at<input name="publishedAt" type="datetime-local" value="<%= editing?.publishedAt ? new Date(editing.publishedAt).toISOString().slice(0,16) : '' %>"></label></div><div class="field"><label>Status<select name="status"><% ['draft','published','archived'].forEach(s=> { %><option value="<%= s %>" <%= (editing?.status||'draft')===s?'selected':'' %>><%= s %></option><% }) %></select></label></div><div class="admin-actions"><button class="btn btn-primary" type="submit"><%= editing?'Save changes':'Create' %></button><% if(editing){ %><a class="btn" href="/admin/videos">Cancel</a><button class="btn btn-danger" type="submit" formaction="/admin/videos/<%= editing._id %>/archive">Archive</button><% } %></div></form></section><section><div class="table-wrap"><table><thead><tr><th>Video</th><th>Status</th><th>Published</th><th></th></tr></thead><tbody><% items.forEach(i=> { %><tr><td><strong><%= i.title %></strong></td><td><span class="status"><%= i.status %></span></td><td><%= i.publishedAt ? new Date(i.publishedAt).toLocaleDateString('en-GB') : '—' %></td><td><a href="/admin/videos?edit=<%= i._id %>">Edit</a></td></tr><% }) %></tbody></table></div></section></div><%- include('../partials/admin-foot') %>
