<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Dashboard</h1><p>Publishing health and content work that needs attention.</p></div><div class="admin-actions"><a class="btn btn-primary" href="/admin/articles/new">+ New article</a></div></div><div class="stats-grid"><article class="stat-card"><strong><%= stats.draft %></strong><span>Draft articles</span></article><article class="stat-card"><strong><%= stats.scheduled %></strong><span>Scheduled</span></article><article class="stat-card"><strong><%= stats.published %></strong><span>Published</span></article><article class="stat-card"><strong><%= stats.archived %></strong><span>Archived</span></article><article class="stat-card"><strong><%= stats.missingLinkedIn %></strong><span>Missing LinkedIn summary</span></article><article class="stat-card"><strong><%= stats.missingSeo %></strong><span>Missing SEO metadata</span></article><article class="stat-card"><strong><%= stats.missingCover %></strong><span>Missing cover image</span></article></div><section class="panel"><h2>Recently updated</h2><% if(stats.recent.length){ %><div class="table-wrap"><table><thead><tr><th>Article</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% stats.recent.forEach(a=> { %><tr><td><strong><%= a.title %></strong><br><small>/<%= a.slug %></small></td><td><span class="status"><%= a.status %></span></td><td><%= new Date(a.updatedAt).toLocaleString('en-GB') %></td><td><a href="/admin/articles/<%= a._id %>">Edit</a></td></tr><% }) %></tbody></table></div><% }else{ %><p>No articles yet.</p><% } %></section><%- include('../partials/admin-foot') %>
