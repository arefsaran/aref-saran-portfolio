<%- include('../partials/admin-head',{title}) %>
<div class="admin-top"><div><h1>Dashboard</h1><p>Manage your technical articles.</p></div><a class="btn btn-primary" href="/admin/articles/new">+ New article</a></div>
<div class="stats-grid"><article class="stat-card"><strong><%= stats.draft %></strong><span>Draft articles</span></article><article class="stat-card"><strong><%= stats.published %></strong><span>Published articles</span></article></div>
<section class="panel"><h2>Recently updated</h2><% if (stats.recent.length) { %><div class="table-wrap"><table><thead><tr><th>Article</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% stats.recent.forEach(article => { %><tr><td><strong><%= article.title %></strong><br><small>/<%= article.slug %></small></td><td><span class="status"><%= article.status %></span></td><td><%= new Date(article.updatedAt).toLocaleString('en-GB') %></td><td><a href="/admin/articles/<%= article._id %>">Edit</a></td></tr><% }) %></tbody></table></div><% } else { %><p>No articles yet.</p><% } %></section>
<%- include('../partials/admin-foot') %>
