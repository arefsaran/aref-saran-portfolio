<%- include('../partials/admin-head',{title}) %><div class="admin-top"><div><h1>Tags & series</h1><p>Normalize taxonomy without duplicating nearly identical labels.</p></div></div><div class="split-list"><section class="panel"><h2>Tags</h2><% if(tags.length){ tags.forEach(tag=> { %><form method="post" class="filters" action="/admin/taxonomy/tag/rename"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= tag %>"><input name="to" value="<%= tag %>" aria-label="Rename tag <%= tag %>"><button class="btn" type="submit">Rename</button><button class="btn btn-danger" type="submit" formaction="/admin/taxonomy/tag/delete" name="tag" value="<%= tag %>">Remove</button></form><% }) } else { %><p>No tags yet.</p><% } %></section><section class="panel"><h2>Series</h2><% if(series.length){ series.forEach(item=> { %><form method="post" class="filters" action="/admin/taxonomy/series/rename"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="from" value="<%= item %>"><input name="to" value="<%= item %>" aria-label="Rename series <%= item %>"><button class="btn" type="submit">Rename</button><button class="btn btn-danger" type="submit" formaction="/admin/taxonomy/series/delete" name="series" value="<%= item %>">Remove</button></form><% }) } else { %><p>No series yet.</p><% } %></section></div><%- include('../partials/admin-foot') %>
