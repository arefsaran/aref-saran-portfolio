<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f6f5f1">
  <meta name="description" content="<%= description || settings.defaultSeoDescription %>">
  <meta name="author" content="<%= settings.authorName %>">
  <meta name="robots" content="<%= preview ? 'noindex,nofollow' : 'index,follow' %>">
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <link rel="alternate" type="application/rss+xml" title="Aref Saran — QA Engineering Writing" href="/rss.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css?v=20260923">
  <script defer src="/script.js"></script>
  <meta property="og:type" content="<%= article ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= title %> — <%= settings.authorName %>">
  <meta property="og:description" content="<%= description || '' %>">
  <meta property="og:url" content="<%= canonical || baseUrl + currentPath %>">
  <meta property="og:image" content="<%= ogImage ? (ogImage.startsWith('http') ? ogImage : baseUrl + ogImage) : (settings.defaultOgImage.startsWith('http') ? settings.defaultOgImage : baseUrl + settings.defaultOgImage) %>">
  <meta name="twitter:card" content="summary_large_image">
  <title><%= title %> — <%= settings.authorName %></title>
  <% if (article && !preview) { %><script type="application/ld+json"><%- jsonLd({"@context":"https://schema.org","@type":"BlogPosting",headline:article.title,description:article.excerpt,datePublished:article.publishedAt || undefined,dateModified:article.updatedAt || undefined,author:{"@type":"Person",name:settings.authorName,url:baseUrl},mainEntityOfPage:canonical || baseUrl + currentPath}) %></script><% } %>
</head>
<body class="content-body">
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="nav-shell">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">AS</span><span class="brand-copy"><strong><%= settings.authorName %></strong><small>QA / Test Automation</small></span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav"><span>Menu</span></button>
  <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
    <a href="/experience">Experience</a><a href="/expertise">Expertise</a><a href="/projects">Projects</a><a href="/articles">Writing</a><a href="/about">About</a><a href="/contact">Contact</a>
  </nav>
</div></header>
<main id="main" class="content-main">
