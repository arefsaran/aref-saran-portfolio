<%- include('../partials/site-head', { title, description, canonical: baseUrl + '/projects', ogImage: null, article: null, preview: false }) %>
<section class="content-hero"><p class="eyebrow">Engineering projects</p><h1>Runnable proof matters more than tool lists.</h1><p>Public, experimental, and planned projects that support my Test Engineering portfolio.</p></section>
<% if(items.length){ %><div class="content-grid"><% items.forEach(item=> { %><article id="<%= item.slug %>" class="content-card"><span class="status-pill"><%= item.status %></span><h2><%= item.name %></h2><p><%= item.summary %></p><div class="tag-row"><% (item.technologies||[]).forEach(t=> { %><span><%= t %></span><% }) %></div><p><% if(item.githubUrl){ %><a class="text-link" target="_blank" rel="noopener noreferrer" href="<%= item.githubUrl %>">GitHub ↗</a><% } %> <% if(item.liveUrl){ %><a class="text-link" target="_blank" rel="noopener noreferrer" href="<%= item.liveUrl %>">Live ↗</a><% } %></p></article><% }) %></div><% } else { %><div class="empty-state">No public projects have been added yet.</div><% } %>
<%- include('../partials/site-foot') %>
