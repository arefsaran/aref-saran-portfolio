<%- include('../partials/site-head', { title, description, canonical, ogImage, article, preview: preview || false }) %>
<article class="article-shell"><header class="article-header"><% if (preview) { %><div class="notice-banner"><strong>Private preview.</strong> This article is not publicly indexed.</div><% } %><p class="case-eyebrow"><%= article.series || 'Test Engineering Note' %></p><h1><%= article.title %></h1><p><%= article.excerpt %></p><div class="article-meta"><span><%= article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('en-GB') : 'Draft' %></span><span><%= readingTime %> min read</span><span><%= article.language.toUpperCase() %></span></div><div class="tag-row" style="margin-top:1rem"><% (article.tags||[]).forEach(tag=> { %><span><%= tag %></span><% }) %></div></header><div class="article-body"><%- html %></div></article>
<% if ((article.relatedCaseStudies||[]).length || (article.relatedProjects||[]).length || (article.relatedVideos||[]).length) { %><section class="related-section"><h2>Related engineering work</h2><div class="content-grid"><% (article.relatedCaseStudies||[]).forEach(item=> { %><article class="content-card"><p class="case-eyebrow">Case study</p><h3><a href="/case-studies#<%= item.slug %>"><%= item.title %></a></h3><p><%= item.summary %></p></article><% }) %><% (article.relatedProjects||[]).forEach(item=> { %><article class="content-card"><p class="case-eyebrow">Project</p><h3><a href="/projects#<%= item.slug %>"><%= item.name %></a></h3><p><%= item.summary %></p></article><% }) %><% (article.relatedVideos||[]).forEach(item=> { %><article class="content-card"><p class="case-eyebrow">Video</p><h3><a href="<%= item.youtubeUrl || '/videos' %>" <%= item.youtubeUrl?'target="_blank" rel="noopener noreferrer"':'' %>><%= item.title %></a></h3><p><%= item.description || '' %></p></article><% }) %></div></section><% } %>
<% if (related?.length) { %><section class="related-section"><h2>Related engineering notes</h2><div class="content-grid"><% related.forEach(a=> { %><article class="content-card"><h3><a href="/articles/<%= a.slug %>"><%= a.title %></a></h3><p><%= a.excerpt %></p></article><% }) %></div></section><% } %>
<%- include('../partials/site-foot') %>
