<%- include('../partials/site-head', { title, description, canonical: baseUrl + '/articles', ogImage: null, article: null, preview: false }) %>
<section class="content-hero"><p class="eyebrow">Writing</p><h1>Technical notes from quality engineering practice.</h1><p>Long-form work on FinTech testing, automation architecture, APIs, CI/CD, performance, and engineering leadership.</p></section>
<form class="filter-bar" method="get" action="/articles"><input name="q" value="<%= filters.q || '' %>" placeholder="Search articles" aria-label="Search articles"><select name="series" aria-label="Filter by series"><option value="">All series</option><% series.forEach(item=> { %><option value="<%= item %>" <%= filters.series===item?'selected':'' %>><%= item %></option><% }) %></select><select name="tag" aria-label="Filter by tag"><option value="">All tags</option><% tags.forEach(item=> { %><option value="<%= item %>" <%= filters.tag===item?'selected':'' %>><%= item %></option><% }) %></select><button class="button button-primary" type="submit">Filter</button></form>
<% if (articles.length) { %><div class="content-grid"><% articles.forEach(a=> { %><article class="content-card"><p class="case-eyebrow"><%= a.series || 'Test Engineering Note' %> · <%= a.publishedAt ? new Date(a.publishedAt).toLocaleDateString('en-GB') : '' %></p><h2><a href="/articles/<%= a.slug %>"><%= a.title %></a></h2><p><%= a.excerpt %></p><div class="tag-row"><% (a.tags||[]).slice(0,4).forEach(tag=> { %><span><%= tag %></span><% }) %></div><p><a class="text-link" href="/articles/<%= a.slug %>">Read article →</a></p></article><% }) %></div><% } else { %><div class="empty-state"><strong>No published articles yet.</strong><p>The CMS is ready for the first engineering note.</p></div><% } %>
<%- include('../partials/site-foot') %>
