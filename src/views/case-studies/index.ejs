<%- include('../partials/site-head', { title, description, canonical: baseUrl + '/case-studies', ogImage: null, article: null, preview: false }) %>
<section class="content-hero"><p class="eyebrow">Case studies</p><h1>How I reason about risk, architecture, and evidence.</h1><p>Generalized engineering cases. Confidential company details remain excluded.</p></section>
<% if(items.length){ %><div class="content-grid"><% items.forEach(item=> { %><article id="<%= item.slug %>" class="content-card"><p class="case-eyebrow">Case study</p><h2><%= item.title %></h2><p><%= item.summary %></p><% if(item.problem){ %><h3>Problem</h3><p><%= item.problem %></p><% } %><% if(item.approach){ %><h3>Approach</h3><p><%= item.approach %></p><% } %><% if(item.result){ %><h3>Result</h3><p><%= item.result %></p><% } %><div class="tag-row"><% (item.technologies||[]).forEach(t=> { %><span><%= t %></span><% }) %></div></article><% }) %></div><% } else { %><div class="empty-state">No published case studies yet.</div><% } %>
<%- include('../partials/site-foot') %>
