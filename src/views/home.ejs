<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#f4f1e8">
  <meta name="description" content="<%= settings.defaultSeoDescription %>"><meta name="author" content="<%= settings.authorName %>"><meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= baseUrl %>/"><link rel="alternate" type="application/rss+xml" title="Aref Saran — QA Engineering Writing" href="/rss.xml"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/styles.css"><script defer src="/script.js"></script>
  <meta property="og:type" content="profile"><meta property="og:title" content="<%= settings.siteTitle %>"><meta property="og:description" content="<%= settings.defaultSeoDescription %>"><meta property="og:url" content="<%= baseUrl %>/"><meta property="og:image" content="<%= settings.defaultOgImage.startsWith('http') ? settings.defaultOgImage : baseUrl + settings.defaultOgImage %>">
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%= settings.siteTitle %>"><meta name="twitter:description" content="<%= settings.defaultSeoDescription %>"><meta name="twitter:image" content="<%= settings.defaultOgImage.startsWith('http') ? settings.defaultOgImage : baseUrl + settings.defaultOgImage %>">
  <title><%= settings.siteTitle %></title>
  <script type="application/ld+json"><%- jsonLd({"@context":"https://schema.org","@graph":[{"@type":"WebSite",name:settings.siteTitle,url:baseUrl},{"@type":"ProfilePage",url:baseUrl,mainEntity:{"@id":`${baseUrl}/#person`}},{"@type":"Person","@id":`${baseUrl}/#person`,name:settings.authorName,url:baseUrl,image:`${baseUrl}/assets/aref-saran-profile.webp`,jobTitle:"Senior QA / Test Automation Engineer",sameAs:[settings.linkedinUrl,settings.githubUrl].filter(Boolean),knowsAbout:["FinTech quality engineering","Credit systems","Payment testing","API testing","Test automation","Robot Framework","Python","CI/CD"]}]}) %></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><div class="nav-shell"><a class="brand" href="/" aria-label="Aref Saran, home"><span class="brand-mark" aria-hidden="true">AS</span><span class="brand-copy"><strong>Aref Saran</strong><small>QA / Test Automation</small></span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav"><span>Menu</span></button><nav id="primary-nav" class="primary-nav" aria-label="Primary navigation"><a href="/experience">Experience</a><a href="/expertise">Expertise</a><a href="/projects">Projects</a><a href="/articles">Writing</a><a href="/about">About</a><a class="nav-contact" href="/contact">Contact</a></nav></div></header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">FinTech · Credit · Payments</p><h1 id="hero-title">Senior QA /<br><span>Test Automation Engineer</span></h1><p class="hero-lead">I engineer reliable test systems for business-critical financial workflows across API, integration, database, workflow, and end-to-end layers.</p><div class="hero-actions"><a class="button button-primary" href="/experience">View experience</a><a class="button button-secondary" href="/projects">View technical work</a></div><div class="hero-proof"><span><%= settings.opportunityText %></span><a href="<%= settings.cvUrl %>" download>Download résumé</a><a href="/articles">Read articles</a><a href="<%= settings.linkedinUrl %>" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="<%= settings.githubUrl %>" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div><aside class="hero-brief" aria-label="Core engineering focus"><figure class="hero-portrait"><picture><source srcset="/assets/aref-saran-profile.webp" type="image/webp"><img src="/assets/aref-saran-profile.png" alt="Portrait of Aref Saran" width="735" height="861"></picture></figure><div class="hero-brief-copy"><p>Quality engineering for systems where retries, callbacks, state transitions, and financial integrity matter.</p><dl><div><dt>Primary domain</dt><dd>Credit &amp; payments</dd></div><div><dt>Core layers</dt><dd>API · Integration · DB · E2E</dd></div><div><dt>Delivery</dt><dd>GitLab CI · Quality gates · k6</dd></div></dl></div></aside></section>
    <section class="metric-band" aria-label="Verified engineering impact"><article><strong>~2,300</strong><span>API &amp; integration automated tests</span></article><article><strong>~39h → ~2h</strong><span>Regression execution improvement</span></article><article><strong>5+</strong><span>Years across FinTech and e-commerce</span></article></section>
    <section class="section split-intro" aria-labelledby="specialization-title"><div><p class="eyebrow">Core specialization</p><h2 id="specialization-title">Confidence across the full financial workflow.</h2></div><p>I connect product risk to observable evidence: service contracts, database state, workflow progression, provider behavior, idempotency, retry and callback handling, and the customer journey.</p></section>
    <section class="section" aria-labelledby="domains-title"><div class="section-heading"><div><p class="eyebrow">Financial systems quality</p><h2 id="domains-title">Testing the paths where correctness has a cost.</h2></div><a class="text-link" href="/expertise">Explore expertise →</a></div><div class="domain-grid"><article><span>01</span><h3>Credit &amp; allocation</h3><p>Risk-led validation of eligibility, allocation, state transitions, and failure paths.</p></article><article><span>02</span><h3>Purchase &amp; payments</h3><p>API, integration, database, and E2E evidence for transaction-heavy journeys.</p></article><article><span>03</span><h3>Refund &amp; settlement</h3><p>Financial-state checks across callbacks, retries, reconciliation, and eventual consistency.</p></article></div></section>
    <section class="section role-callout" aria-labelledby="role-title"><div><p class="eyebrow">Current role</p><h2 id="role-title">QA Engineer · QA Engineering Chapter Lead</h2><p>Azkivam · Technical QA leadership through standards, mentoring, automation architecture, testability, and cross-team quality practices.</p></div><a class="button button-secondary" href="/experience">Full experience</a></section>
    <section class="section" aria-labelledby="work-title"><div class="section-heading"><div><p class="eyebrow">Selected engineering work</p><h2 id="work-title">Architecture and evidence, not tool demos.</h2></div><a class="text-link" href="/projects">All technical work →</a></div><div class="work-grid"><article class="work-card"><p class="card-label">Automation architecture</p><h3>Regression feedback at scale</h3><p>Execution-safe suite design and CI segmentation reduced a roughly 39-hour regression cycle to roughly two hours across approximately 2,300 tests.</p></article><article class="work-card"><p class="card-label">Financial testing</p><h3>Deterministic provider failure coverage</h3><p>Service virtualization made timeout, invalid-response, retry, and partial-failure scenarios repeatable and diagnosable.</p></article><article class="work-card"><p class="card-label">Developer tooling</p><h3>Repository-specific QA agent</h3><p>A source-grounded QA workflow with explicit policies, reusable skills, evaluation, and fail-closed handling for secrets and unsafe operations.</p></article></div></section>
    <section class="section writing-preview" aria-labelledby="writing-title"><div class="section-heading"><div><p class="eyebrow">Technical writing</p><h2 id="writing-title">Notes from engineering reliable systems.</h2></div><a class="text-link" href="/articles">Browse writing →</a></div><% if (articles.length) { %><div class="writing-list"><% articles.forEach(article => { %><article><p><%= article.series || 'QA Engineering' %></p><h3><a href="/articles/<%= article.slug %>"><%= article.title %></a></h3><span><%= article.excerpt %></span></article><% }) %></div><% } else { %><div class="empty-state"><strong>No articles published yet.</strong><p>The weblog and publishing workflow are ready for the first technical article.</p></div><% } %></section>
    <section class="section experience-preview" aria-labelledby="experience-title"><div><p class="eyebrow">Career progression</p><h2 id="experience-title">E-commerce foundations.<br>Financial systems depth.<br>Automation leadership.</h2></div><ol><li><span>Jun 2026 — Present</span><strong>Azkivam</strong><p>QA Engineer · QA Engineering Chapter Lead</p></li><li><span>2023 — Jun 2026</span><strong>Digipay</strong><p>Software Test Engineer</p></li><li><span>2021 — 2023</span><strong>Tiara Ecommerce</strong><p>Software Test Engineer</p></li></ol></section>
    <section class="section contact-panel" aria-labelledby="contact-title"><div><p class="eyebrow">Germany / Europe</p><h2 id="contact-title">Engineering quality for financial platforms.</h2><p>For Senior QA and Test Automation opportunities in FinTech, payments, lending, and digital banking.</p></div><div class="contact-actions"><a class="button button-primary" href="mailto:<%= settings.publicEmail %>">Email Aref</a><a class="text-link" href="<%= settings.cvUrl %>" download>Download résumé</a><a class="text-link" href="<%= settings.linkedinUrl %>" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></section>
  </main>
  <footer><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">AS</span><strong>Aref Saran</strong></a><p>Senior QA / Test Automation Engineer · FinTech, Credit &amp; Payments</p><a href="/articles">Writing</a></footer>
</body>
</html>
