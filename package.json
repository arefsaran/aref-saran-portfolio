{
  "name": "aref-saran-portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Aref Saran Test Engineering portfolio and publishing CMS",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "build": "node --check server.js && node --check src/app.js",
    "lint": "eslint src server.js scripts tests/unit tests/*.mjs",
    "format:check": "node scripts/check-format.js",
    "admin:create": "node scripts/create-admin.js",
    "verify": "npm run test && npm run lint && npm run format:check && npm run test:e2e",
    "seed:portfolio": "node scripts/seed-existing-content.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.{js,mjs}\" public/admin.js server.js package.json README.md VERIFICATION.md"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.0.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "lusca": "^1.7.0",
    "marked": "^15.0.12",
    "mongoose": "^8.16.5",
    "multer": "^2.0.2",
    "sanitize-html": "^2.17.0",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "mongodb-memory-server": "^10.1.4"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
